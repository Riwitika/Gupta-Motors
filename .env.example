# Gupta Motors — Environment Configuration Template
# Duplicate this file as .env.local for local development.
# Never commit .env or service role keys to version control.

# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (Safe for client-side use)
# DO NOT place service_role keys here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
